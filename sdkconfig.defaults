CONFIG_IDF_TARGET="esp32s3"

# CoreS3: 16 MB flash, 8 MB quad PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Only small allocations (<= 2 KB) default to internal RAM; bigger ones go to PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
# Optimize for speed (the default -Og is for debugging; it slows the face drawing)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Serial log over the CoreS3's USB-C port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Speech recognition (ESP-SR) ---
CONFIG_MODEL_IN_FLASH=y
# Wake word: "Hey Buddy"
CONFIG_SR_WN_WN10_EN_HEYBUDDY=y
# English command recognizer that accepts plain-text commands
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_MULTINET7_QUANT=y

# Face detection models: ESPDet-Pico (accurate, default) and MSR+MNP (fast)
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_FLASH_ESPDET_PICO_224_224_FACE=y

# Camera driver task on core 1; core 0 is busy with speech processing
CONFIG_CAMERA_CORE1=y

# FAT long file names on the SD card (settings.txt, and later sounds/photos)
CONFIG_FATFS_LFN_HEAP=y

# --- Wi-Fi and the Home Assistant connection ---
# TLS buffers in PSRAM (only used with an https:// Home Assistant address)
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# --- Internal RAM for Wi-Fi ---
# Wi-Fi needs ~40 KB of internal (non-PSRAM) memory, and after the speech and
# face models load there wasn't enough (ESP_ERR_NO_MEM on hardware).
# Camera DMA buffer: 30 KB -> under 8 KB (plenty for 160x120 frames).
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192
# Fewer always-allocated Wi-Fi receive buffers (the rest come from PSRAM).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
# Wi-Fi code runs from flash instead of IRAM, which shares space with the heap.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# Lets the Home Assistant client's task keep its stack in PSRAM.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Per-task CPU use (main/cpustats.cpp) for finding what starves a core
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
